---
import Icon from '../components/Icon.astro';
import ProgressiveBlur from '../components/ProgressiveBlur.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortPosts, site } from '../lib/posts';
import { getPublishedPosts } from '../lib/posts';

const posts = sortPosts(await getPublishedPosts());
const postCount = posts.length;
const firstYear = posts.reduce((min, post) => {
  const year = post.data.date?.getFullYear();
  return year && year < min ? year : min;
}, new Date().getFullYear());

// 关于页与项目页共用清单和卡片，GitHub 与后台项目按仓库地址合并。
import ProjectCatalog from '../components/ProjectCatalog.astro';
import { getAbout } from '../lib/site-content';
const about = getAbout();
---

<BaseLayout
  title="关于"
  description={`关于${site.author}，以及这个博客持续记录的内容。`}
  pageClass="content-page spring-inner"
>
  <article class="about">
    <section class="about-collage" aria-label={`关于 ${site.author}`}>
      <p class="eyebrow" data-animate>A LITTLE ABOUT ME</p>
      <h2 data-animate>与代码对话，<br />把日子写成故事。</h2>
      <ProgressiveBlur><div class="about-collage__cards">
        <div class="about-collage__note" tabindex="0" data-tilt data-animate><span>HELLO, WORLD</span><strong>{site.author}</strong><p>保持好奇，认真生活。</p><Icon name="arrow-up-right" size={28} /></div>
        <figure class="about-collage__portrait" tabindex="0" data-tilt data-animate><img src={site.avatar} width="240" height="240" alt={`${site.author} 的头像`} /><figcaption>{site.author} · nice to meet you</figcaption></figure>
        <div class="about-collage__note about-collage__note--index" data-tilt data-animate><span>PERSONAL ARCHIVE</span><strong>{postCount}<small>篇记录</small></strong><p>从 {firstYear} 开始，<br />收集灵感，也留下足迹。</p><a href="/archive/">翻翻我的笔记 <Icon name="arrow-right" size={16} /></a></div>
      </div></ProgressiveBlur>
    </section>
    <header class="about__intro" data-animate>
      <img
        src={site.avatar}
        alt={`${site.author}头像`}
        class="about__avatar"
        width="72"
        height="72"
      />
      <p class="eyebrow">About</p>
      <h1 class="about__lead" set:html={about.lead} />
      {about.subs.map((line) => (
        <p class="about__sub" set:html={line} />
      ))}

      <div class="about__facts" aria-label="站点速览">
        <span class="about__fact">{postCount} 篇文章</span>
        <span class="about__fact">写于 {firstYear} 至今</span>
        {about.facts.map((fact) => (
          <span class="about__fact">{fact}</span>
        ))}
        <span class="about__social" aria-label="找到我">
          {about.socials.map((s) => (
            <a
              class="icon-button"
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={s.label}
            >
              <Icon name={s.icon} />
            </a>
          ))}
        </span>
      </div>
    </header>

    <ProjectCatalog />
  </article>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/posts';
---

<BaseLayout
  title="搜索"
  description={`搜索${site.author}博客中的文章、分类和标签。`}
  pageClass="content-page spring-inner"
>
  <section class="search-page">
    <header class="page-header" data-animate>
      <p class="eyebrow">Search</p>
      <h1>搜索文章</h1>
      <p>输入关键词，快速找到标题、摘要、分类或标签匹配的内容。</p>
    </header>

    <form class="search-box" role="search">
      <label for="search-input">关键词</label>
      <div class="search-box__control">
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="Cursor、部署、Midjourney..."
          autocomplete="off"
        />
        <button type="submit">搜索</button>
      </div>
    </form>

    <p class="search-status" data-search-status role="status" aria-live="polite">正在加载索引...</p>
    <div class="search-results post-list" data-search-results></div>
  </section>
</BaseLayout>

<script>
  // 客户端搜索：对构建期生成的 search.json 索引做加权匹配。
  // 输入带 150ms 防抖，避免每个按键都全量扫描索引。
  import { esc } from '../lib/sanitize.js';

  // 搜索权重（标题 > 分类 > 标签 > 正文）。
  const WEIGHT_TITLE = 4;
  const WEIGHT_CATEGORY = 3;
  const WEIGHT_TAGS = 2;
  const WEIGHT_TEXT = 1;
  // 输入防抖间隔。
  const SEARCH_DEBOUNCE_MS = 150;

  interface SearchItem {
    title: string;
    category: string;
    tags: string[];
    text: string;
    url: string;
    date: string;
    description: string;
  }

  // 索引只请求一次，换页回来直接复用。
  let postsPromise: Promise<SearchItem[]> | null = null;
  const loadPosts = () => {
    postsPromise ??= fetch('/search.json')
      .then((response) => response.json())
      .then((items: SearchItem[]) => (Array.isArray(items) ? items : []));
    return postsPromise;
  };

  const initSearch = () => {
    const form = document.querySelector<HTMLFormElement>('.search-box');
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const status = document.querySelector<HTMLElement>('[data-search-status]');
    const results = document.querySelector<HTMLElement>('[data-search-results]');
    if (!form || !input || !status || !results || form.dataset.ready === '1') return;
    form.dataset.ready = '1';

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') ?? '';
    let posts: SearchItem[] = [];

    const normalize = (value: string) => value.trim().toLowerCase();

    const renderIdle = () => {
      status.textContent = `已索引 ${posts.length} 篇文章。`;
      status.classList.remove('is-error');
      results.innerHTML = '';
    };

    const renderEmpty = (query: string) => {
      status.textContent = `没有找到匹配「${query}」的文章。`;
      status.classList.remove('is-error');
      // 「分类」入口从索引里现算：写死某个分类名在别人的站点上会指向不存在的页面。
      const firstCategory = posts.find((post) => post.category)?.category;
      const categoryLink = firstCategory
        ? `、<a href="/categories/${encodeURIComponent(firstCategory)}/">${esc(firstCategory)}</a> 分类`
        : '';
      // 给出可继续操作的入口，而不是留一片空白。
      results.innerHTML = `
        <p class="empty-hint">
          试试其他关键词，或从 <a href="/archive/">归档</a>${categoryLink} 继续浏览。
        </p>
      `;
    };

    const renderResults = (query: string) => {
      const normalizedQuery = normalize(query);

      if (!normalizedQuery) {
        renderIdle();
        return;
      }

      const terms = normalizedQuery.split(/\s+/).filter(Boolean);
      const matches = posts
        .map((post) => ({
          post,
          score: terms.reduce((score, term) => {
            if (post.title.toLowerCase().includes(term)) return score + WEIGHT_TITLE;
            if (post.category.toLowerCase().includes(term)) return score + WEIGHT_CATEGORY;
            if (post.tags.join(' ').toLowerCase().includes(term)) return score + WEIGHT_TAGS;
            if (post.text.includes(term)) return score + WEIGHT_TEXT;
            return score;
          }, 0),
        }))
        .filter((item) => item.score > 0)
        .sort((a, b) => b.score - a.score || a.post.title.localeCompare(b.post.title, 'zh-CN'));

      if (!matches.length) {
        renderEmpty(query.trim());
        return;
      }

      status.textContent = `找到 ${matches.length} 篇相关文章。`;
      status.classList.remove('is-error');

      results.innerHTML = matches
        .map(({ post }) => {
          const tags = post.tags
            .slice(0, 4)
            .map((tag) => `<span>${esc(tag)}</span>`)
            .join('');

          return `
            <article class="post-row post-row--plain is-revealed">
              <a href="${esc(post.url)}">
                <div class="post-row__main">
                  <div class="post-meta">
                    ${post.category ? `<span>${esc(post.category)}</span>` : ''}
                    ${post.date ? `<span>${esc(post.date)}</span>` : ''}
                  </div>
                  <h3>${esc(post.title)}</h3>
                  ${post.description ? `<p>${esc(post.description)}</p>` : ''}
                  ${tags ? `<div class="tag-list" aria-label="标签">${tags}</div>` : ''}
                </div>
              </a>
            </article>
          `;
        })
        .join('');
    };

    const syncUrl = (query: string) => {
      const nextUrl = new URL(window.location.href);

      if (query) {
        nextUrl.searchParams.set('q', query);
      } else {
        nextUrl.searchParams.delete('q');
      }

      window.history.replaceState({}, '', nextUrl);
    };

    const runSearch = () => {
      const query = input.value.trim();
      syncUrl(query);
      renderResults(query);
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      runSearch();
    });

    // 防抖：连续输入只在停顿 150ms 后扫描一次索引。
    let debounceTimer = 0;
    input.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(runSearch, SEARCH_DEBOUNCE_MS);
    });

    input.value = initialQuery;

    // 统一的索引加载入口：成功与失败都由此收口，重试时复用同一段逻辑。
    const loadIndex = () => {
      statusText('正在加载索引...');
      postsPromise = null;
      loadPosts()
        .then((items) => {
          posts = items;
          renderResults(input.value);
        })
        .catch(() => {
          // 索引加载失败与「没有结果」必须区分：标记错误态并给出重试入口。
          statusText('搜索索引加载失败，请检查网络后重试。', true);
          results.innerHTML = `
            <p class="empty-hint">
              索引没能加载成功。<button type="button" class="text-link" data-search-retry>重新加载</button>
            </p>
          `;
          results.querySelector('[data-search-retry]')?.addEventListener('click', loadIndex);
        });
    };

    function statusText(message: string, isError = false) {
      status?.classList.toggle('is-error', isError);
      if (status) status.textContent = message;
    }

    loadIndex();
  };

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>

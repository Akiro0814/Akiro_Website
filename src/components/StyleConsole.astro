---
import CursorSettings from './CursorSettings.astro';
const styles = [
  { id: 'life', label: '生活', en: 'Life', color: '#d97757' },
  { id: 'swiss', label: '瑞士', en: 'Swiss', color: '#e43d30' },
  { id: 'minimalist', label: '极简', en: 'Minimal', color: '#929d91' },
  { id: 'glass', label: '玻璃', en: 'Glass', color: '#a78aca' },
  { id: 'brutalist', label: '粗野', en: 'Brutal', color: '#f5ca42' },
];
---
<button class="atlas-style-toggle" type="button" data-style-toggle aria-label="外观设置" aria-haspopup="dialog" aria-controls="style-console" aria-expanded="false" title="外观设置"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3" fill="var(--bg)"/><circle cx="15" cy="17" r="3" fill="var(--bg)"/></svg></button>
<dialog id="style-console" class="atlas-console" aria-labelledby="style-title" data-lenis-prevent>
  <div class="atlas-menu__head"><div><small>MAKE YOURSELF AT HOME</small><h2 id="style-title">换一种心情</h2></div><button type="button" class="atlas-icon" data-dialog-close aria-label="关闭外观设置">✕</button></div>
  <p class="atlas-console__description">同一份记录，不一样的观看方式。</p>
  <div class="console-tabs" role="tablist" aria-label="设置类别">
    <button type="button" id="appearance-tab" role="tab" data-console-tab="appearance" aria-controls="appearance-panel" aria-selected="true">页面外观</button>
    <button type="button" id="cursor-tab" role="tab" data-console-tab="cursor" aria-controls="cursor-panel" aria-selected="false" tabindex="-1">光标设置</button>
  </div>
  <section id="appearance-panel" role="tabpanel" aria-labelledby="appearance-tab">
  <div class="atlas-style-grid" role="group" aria-label="视觉风格">
    {styles.map((style) => <button type="button" data-style-choice={style.id} aria-pressed={style.id === 'life'} style={`--swatch:${style.color}`}><span class={`atlas-style-preview atlas-style-preview--${style.id}`} aria-hidden="true"><i></i><b>Aa</b><em></em></span><strong>{style.label}</strong><small>{style.en}</small></button>)}
  </div>
  <fieldset class="atlas-mode"><legend>切换方式</legend><div>{[{ id: 'manual', label: '手动选择' }, { id: 'time', label: '随时间' }, { id: 'scroll', label: '随滚动' }].map((mode) => <button type="button" data-style-mode={mode.id} aria-pressed={mode.id === 'manual'}>{mode.label}</button>)}</div></fieldset>
  <p class="atlas-console__hint" data-style-hint aria-live="polite">偏好保存在当前浏览器。</p>
  <button type="button" class="atlas-style-reset" data-style-reset>恢复站点默认</button>
  </section>
  <section id="cursor-panel" role="tabpanel" aria-labelledby="cursor-tab" hidden><CursorSettings /></section>
</dialog>

<style>
  .console-tabs { display:flex; gap:4px; padding:4px; border-radius:var(--radius-sm); background:var(--bg-tint); margin-bottom:18px; }
  .console-tabs button { flex:1; min-height:40px; border:0; border-radius:calc(var(--radius-sm) - 4px); color:var(--text-muted); background:transparent; font:inherit; font-size:12px; cursor:pointer; }
  .console-tabs [aria-selected='true'] { color:var(--text); background:var(--surface); box-shadow:var(--shadow); }
  [role='tabpanel'][hidden] { display:none; }
</style>

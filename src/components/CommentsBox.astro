---
// 底部评论框 —— 官方 Twikoo SDK，样式由博客主题适配。
interface Props {
  title?: string;
}
const { title = '评论' } = Astro.props;
---

<section class="cbox" data-cbox>
  <div class="cbox__head">
    <h2 class="cbox__title">{title}</h2>
    <span class="cbox__count" data-c-count></span>
  </div>
  <p class="comment-service-status">评论提交后，等待站长构建发布后展示。点赞数量也在发布后更新。</p>
  <div data-c-mount></div>
</section>

<script>
  import { mountComments, commentsBackendId } from '../lib/comments.js';

  // 始终从本站入口访问；是否转发外部环境由后台决定，确保前后台管理同一份评论。
  const ENV_ID = commentsBackendId();
  let activeRoot: HTMLElement | null = null;
  let cleanup = () => {};

  const initComments = () => {
    const root = document.querySelector<HTMLElement>('[data-cbox]');
    if (root === activeRoot) return;

    cleanup();
    activeRoot = root;
    if (!root) return;

    const controller = new AbortController();
    const mountEl = root.querySelector<HTMLElement>('[data-c-mount]');
    const countEl = root.querySelector('[data-c-count]');
    if (!mountEl || !countEl) return;
    let started = false;
    let api: ReturnType<typeof mountComments> | null = null;

    const start = () => {
      if (started) return api;
      started = true;
      api = mountComments(mountEl, {
        envId: ENV_ID,
        url: location.pathname,
        onCount: (n: number) => {
          countEl.textContent = n ? `· ${n}` : '';
        },
      });
      return api;
    };

    const quoteComment = (detail: WindowEventMap['blog:quote-comment']['detail']) => {
      const instance = start();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => instance?.quote(detail), 180);
    };

    window.addEventListener(
      'blog:quote-comment',
      (event) => quoteComment(event.detail),
      { signal: controller.signal },
    );

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          start();
          io.disconnect();
        }
      },
      { rootMargin: '400px' },
    );
    io.observe(root);
    cleanup = () => {
      controller.abort();
      io.disconnect();
      api?.dispose();
    };
  };

  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>

---
// 极简光标（保留 SmoothCursor 组件名）：采用用户确认的墨黑 SVG。
//   - 默认以 24×30px 显示；大小、缓动与反馈均由共享光标偏好控制
//   - 图形围绕尖端缩放，移动采用短程缓动；按下和拖动立即贴合真实指针
//   - 悬停链接/按钮时放大、按下时收缩反馈
// 仅在支持鼠标的设备启用；文本输入框保留系统文本光标；
// prefers-reduced-motion 时关闭跟随缓动与缩放过渡。元素带 transition:persist，
// View Transitions 换页时保持同一 DOM 节点。
---

<div id="smooth-cursor" aria-hidden="true" transition:persist="smooth-cursor">
  <div id="sc-pos">
    <div class="sc-face">
      <img src="/cursor/akiro-minimal-ink.svg" width="24" height="30" alt="" draggable="false" />
    </div>
  </div>
</div>

<style>
  /* 脚本就绪后才隐藏系统光标（JS 加类），脚本不可用时浏览器保持默认光标。
     用「全部元素 + !important」而不是逐类列举：全局样式里的 cursor 声明
     （如导航图标按钮的 pointer、文章图片的 zoom-in）特异性更高，逐类列举
     会被压过，导致悬停部分按钮时系统光标重新露出来。 */
  :global(html.sc-on),
  :global(html.sc-on *) {
    cursor: none !important;
  }
  /* 文本输入场景必须保留系统文本光标，否则无法看到插入点位置 */
  :global(html.sc-on input:not([type='button']):not([type='submit']):not([type='reset']):not([type='checkbox']):not([type='radio']):not([type='range']):not([type='color']):not([type='file']):not([type='hidden'])),
  :global(html.sc-on textarea),
  :global(html.sc-on [contenteditable]) {
    cursor: text !important;
  }

  #smooth-cursor {
    position: fixed;
    inset: 0;
    pointer-events: none;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    z-index: 2147483000;
    opacity: 0;
    transition: opacity 0.15s ease-out;
  }
  #smooth-cursor.sc-visible:not(.sc-text):not([data-enabled='false']) {
    opacity: 1;
  }
  #smooth-cursor::backdrop { background: transparent; pointer-events: none; }

  /* 外层只做视口定位，内层围绕热点缩放，确保悬停与按下不会挪动箭头尖端。 */
  #sc-pos {
    position: fixed;
    left: 0;
    top: 0;
    will-change: transform;
  }

  .sc-face {
    /* 以 SVG viewBox 比例计算偏移与缩放原点，修改尺寸后热点仍精确对齐。 */
    margin: calc(var(--sc-size,24px) * -.1484375) 0 0 calc(var(--sc-size,24px) * -.2109375);
    transform-origin: calc(var(--sc-size,24px) * .2109375) calc(var(--sc-size,24px) * .1484375);
    transition: transform var(--sc-transition,180ms) cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(1);
  }

  .sc-face img {
    display: block;
    width: var(--sc-size,24px);
    height: calc(var(--sc-size,24px) * 1.25);
    user-select: none;
    /* SVG 已含白色描边和轻阴影，不叠加旧光标的彩色阴影。 */
  }

  /* 悬停可交互元素：轻微放大 */
  :global(#smooth-cursor.sc-hover) .sc-face {
    transform: scale(var(--sc-hover,1.07));
  }
  /* 按下反馈：收缩 */
  :global(#smooth-cursor.sc-press) .sc-face {
    transform: scale(var(--sc-press,.94));
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-face {
      transition: none;
    }
    :global(#smooth-cursor.sc-hover) .sc-face {
      transform: scale(1);
    }
    :global(#smooth-cursor.sc-press) .sc-face {
      transform: scale(1);
    }
  }
</style>

<script>
  import { CURSOR_STORAGE_KEY, getCursorSettings, reloadCursorSettings } from '../lib/cursor-settings.js';
  import { advanceCursor } from '../lib/cursor-motion.js';
  // 单个 rAF 循环驱动全部状态；transition:persist 保证换页后元素仍在，
  // 事件全部委托到 window/document，无需在 astro:page-load 时重绑。
  const finePointer = window.matchMedia('(pointer: fine)');

  function initSmoothCursor() {
    const root = document.getElementById('smooth-cursor');
    if (!root) return;
    // 原生 dialog 位于浏览器顶层，普通元素的 z-index 再大也无法覆盖它。
    // 手动 popover 同样进入顶层；不重挂到带 GSAP transform 的 dialog 内，
    // 从而保持指针一直使用视口坐标，避免弹窗进场时出现偏移。
    const promote = () => {
      if (!('showPopover' in root)) return;
      root.setAttribute('popover', 'manual');
      try {
        if (root.matches(':popover-open')) root.hidePopover();
        root.showPopover();
      } catch { root.removeAttribute('popover'); }
    };
    // Astro 换页会替换 html 的属性，持久光标与新面板须重新应用同一份本机偏好。
    const applyShell = (preferences: ReturnType<typeof getCursorSettings>) => {
      const html = document.documentElement;
      html.style.setProperty('--sc-size', `${preferences.size}px`);
      html.style.setProperty('--sc-hover', String(preferences.hoverScale));
      html.style.setProperty('--sc-press', String(preferences.pressScale));
      html.style.setProperty('--sc-transition', `${preferences.transition}ms`);
      const active = preferences.enabled && finePointer.matches && ('showPopover' in root || !document.querySelector('dialog[open]'));
      html.classList.toggle('sc-on', active);
      root.dataset.enabled = String(active);
      if (active) {
        if ('showPopover' in root && !root.matches(':popover-open')) promote();
      } else {
        root.classList.remove('sc-visible', 'sc-press');
        if ('hidePopover' in root && root.matches(':popover-open')) root.hidePopover();
      }
    };
    applyShell(getCursorSettings());
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    window.addEventListener('akiro:modal', () => {
      if (!settings.enabled || !finePointer.matches) return;
      if ('showPopover' in root) promote();
      else applyShell(settings);
    });
    // 自适应解析缓动兼顾漂浮感与快速移动的跟手性，不再对位置做硬截断。
    let settings = getCursorSettings();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let targetX = window.innerWidth / 2;
    let targetY = window.innerHeight / 2;
    let currentX = targetX;
    let currentY = targetY;
    let positionKnown = false;
    let pressed = false;
    let lastFrame = performance.now();
    const renderPosition = () => {
      const pos = document.getElementById('sc-pos');
      if (pos) pos.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
    };
    const snapPosition = (x: number, y: number) => {
      targetX = currentX = x;
      targetY = currentY = y;
      positionKnown = true;
      renderPosition();
    };
    const applySettings = () => {
      const previous = settings.enabled;
      settings = getCursorSettings();
      applyShell(settings);
      if (previous !== settings.enabled || !finePointer.matches) positionKnown = false;
      if (!settings.smooth || reducedMotion.matches) snapPosition(targetX, targetY);
    };
    window.addEventListener('akiro:cursor-settings', applySettings);
    window.addEventListener('storage', (event) => {
      if (event.key === CURSOR_STORAGE_KEY || event.key === null) reloadCursorSettings();
    });
    finePointer.addEventListener('change', applySettings);
    reducedMotion.addEventListener('change', applySettings);

    // 悬停判定走事件委托；input/textarea 除外（那里保留系统文本光标）
    const HOVERABLE = 'a, button, label, summary, select, [role="button"], [role="link"]';
    const TEXT_INPUT = "textarea, [contenteditable]:not([contenteditable='false']), input:not([type='button']):not([type='submit']):not([type='reset']):not([type='checkbox']):not([type='radio']):not([type='range']):not([type='color']):not([type='file']):not([type='hidden'])";

    window.addEventListener('mousemove', (e) => {
      if (!settings.enabled || !finePointer.matches) return;
      targetX = e.clientX;
      targetY = e.clientY;
      const rootNow = document.getElementById('smooth-cursor');
      if (rootNow) {
        const t = e.target;
        const isText = t instanceof Element && t.closest(TEXT_INPUT) !== null;
        // 首次出现或从输入框返回时直接定位，避免从旧位置飞入；拖动始终精确跟手。
        if (!positionKnown || pressed || !settings.smooth || reducedMotion.matches || isText || rootNow.classList.contains('sc-text')) {
          snapPosition(targetX, targetY);
        }
        rootNow.classList.add('sc-visible');
        // 文本输入时只显示系统 I 形指针，避免两个光标同时出现。
        rootNow.classList.toggle('sc-text', isText);
        rootNow.classList.toggle(
          'sc-hover',
          t instanceof Element && t.closest(HOVERABLE) !== null,
        );
      }
    }, { passive: true });

    window.addEventListener('mousedown', (event) => {
      if (!settings.enabled || !finePointer.matches) return;
      pressed = true;
      // 点击发生的这一刻同步归位，不让缓动中的视觉位置误导命中目标。
      snapPosition(event.clientX, event.clientY);
      document.getElementById('smooth-cursor')?.classList.add('sc-press');
    });
    window.addEventListener('mouseup', (event) => {
      pressed = false;
      if (settings.enabled && finePointer.matches) snapPosition(event.clientX, event.clientY);
      document.getElementById('smooth-cursor')?.classList.remove('sc-press');
    });
    const hide = () => {
      positionKnown = false;
      pressed = false;
      document.getElementById('smooth-cursor')?.classList.remove('sc-visible', 'sc-press');
    };
    // 离开窗口或切换应用时清除按下状态，重新进入后从当前位置开始。
    document.documentElement.addEventListener('mouseleave', hide);
    window.addEventListener('blur', hide);

    function tick(now: number) {
      const dt = Math.max(0, now - lastFrame);
      lastFrame = now;
      if (!settings.enabled || !finePointer.matches) {
        requestAnimationFrame(tick);
        return;
      }
      if (reducedMotion.matches || pressed || !settings.smooth) {
        currentX = targetX;
        currentY = targetY;
      } else {
        const next = advanceCursor({ x: currentX, y: currentY }, { x: targetX, y: targetY }, dt, settings);
        currentX = next.x;
        currentY = next.y;
      }
      // 每帧重新查找当前节点，保持 Astro 跨页与顶层 popover 的坐标一致。
      renderPosition();

      requestAnimationFrame(tick);
    }

    // 防止换页脚本重跑时叠加多个循环
    if (!window.__scLoop) {
      window.__scLoop = true;
      requestAnimationFrame(tick);
    }
  }

  initSmoothCursor();
  document.addEventListener('astro:page-load', initSmoothCursor);
</script>

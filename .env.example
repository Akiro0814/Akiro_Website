SITE_URL=https://example.com

# —— 后台管理端 ——
# 管理员登录名
ADMIN_USER=Akiro
# 密码哈希（scrypt）。用 `npm run admin:hash` 生成，不要写明文密码。
ADMIN_PASSWORD_HASH=replace-me-with-npm-run-admin-hash
# 会话签名密钥（随机长字符串；生产环境必填——弱/占位值会被拒绝启动）
SESSION_SECRET=replace-me-with-a-long-random-string
# 管理端监听端口（nginx 反代到这个端口）
ADMIN_PORT=4000
# 部署在 HTTPS 后面时设为 true；本地开发保持 false
COOKIE_SECURE=false

# —— 前台功能 ——
# 独立评论随后台运行，数据在 data/comments-store.json；后台「评论设置」即时调整。
# 旧 data/twikoo 会在首次访问时备份并迁移，不再加载 Twikoo 服务或 SDK。
# 可选的通知配置：后台已编辑字段 > 环境变量 > 旧库迁移值。真实密码只放私有配置。
COMMENTS_BLOGGER_EMAIL=
COMMENTS_SMTP_HOST=
COMMENTS_SMTP_PORT=465
COMMENTS_SMTP_SECURE=true
COMMENTS_SMTP_USER=
COMMENTS_SMTP_PASS=
COMMENTS_SENDER_EMAIL=
COMMENTS_SENDER_NAME=Akiro
# Server酱 Turbo（可选）
COMMENTS_PUSHOO_CHANNEL=serverchan
COMMENTS_PUSHOO_TOKEN=
# 网易云歌单可选；留空时仍可播放后台管理的本地歌曲，空歌单隐藏播放器。
PUBLIC_NETEASE_PLAYLIST_ID=
# Meting API 地址（公共音乐解析服务，仅 http(s) 公网域名）
PUBLIC_MUSIC_API=https://meting.mikus.ink/api

# —— 数据备份（每次「构建发布」成功后自动执行）——
# 备份开关：false 时发布后不做任何备份。备份在系统临时目录完成、推送后即清理，
# 本地不留缓存副本。
BACKUP_ENABLED=true
# 远端私人仓库地址（GitHub 私库）。后台保存值优先；本项留空时尝试从 GitHub
# origin 推导 <owner>/<repo>-backup.git；无法推导且未配置时跳过备份。
# 首次启用：先在 GitHub 上创建一个私有空仓库（名称与该地址一致），之后无需其他操作。
# 注意：下面仅为格式示例，请替换为你自己的仓库地址；真实地址只写在 .env，勿提交到仓库。
BACKUP_REMOTE_URL=https://github.com/your-name/your-blog-backup.git
# 是否把 .env（后台凭据与密钥）一并备份。默认 false（缩小密钥扩散面）：
# .env 含 SESSION_SECRET 与密码哈希，一旦私库误公开/协作者加入即外泄。
# 确有异地恢复需求再改为 true，并保证私库严格私有。
BACKUP_INCLUDE_ENV=false
